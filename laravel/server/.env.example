# /srv/__APP__/.env
# Read by Docker Compose and passed to every container of __APP__.
# After changing a value:  docker compose up -d
# Avoid "$" in values, or write it as "$$".

# Image tag to run. The image is stored on this server: docker image ls __APP__
APP_TAG=

APP_NAME=__APP__
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://__DOMAIN__

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=__APP__-mysql
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=__APP__-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Keep the app stateless: sessions, cache and queues in Redis,
# uploaded files in object storage.
SESSION_DRIVER=redis
CACHE_STORE=redis
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=https://fra1.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false
