# /srv/__DB__/.env
# MySQL release: 8.4 (LTS) or 8.0. Keep it once the database exists;
# MySQL can't move back to an older release on the same data.
MYSQL_VERSION=8.4

# Database name and passwords. Apps use MYSQL_USER / MYSQL_PASSWORD.
# These are applied only when the database is first created.
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
