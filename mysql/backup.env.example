# /srv/__DB__/backup.env
# Nightly backups. After changing a value:  docker compose up -d

# Hour of the nightly dump, in the server's time zone (UTC unless changed).
BACKUP_HOUR=3
# How many days of dumps to keep, on this server and in object storage.
BACKUP_KEEP_DAYS=14

# Off-server copies in DigitalOcean Spaces (or any S3-compatible storage).
# Leave BACKUP_BUCKET empty to keep dumps on this server only.
BACKUP_BUCKET=
BACKUP_PREFIX=__DB__
RCLONE_CONFIG_SPACES_TYPE=s3
RCLONE_CONFIG_SPACES_PROVIDER=DigitalOcean
RCLONE_CONFIG_SPACES_ENDPOINT=fra1.digitaloceanspaces.com
RCLONE_CONFIG_SPACES_ACCESS_KEY_ID=
RCLONE_CONFIG_SPACES_SECRET_ACCESS_KEY=
